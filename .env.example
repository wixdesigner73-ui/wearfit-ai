# Frontend build-time settings (copy to .env.local for local development). None of these are secrets:
# everything in a static site is public.

# Base URL of the FastAPI try-on backend. Leave empty to run the fitting room in labeled DEMO mode.
# For local development: http://localhost:8000
VITE_TRYON_API_URL=

# Display currency for prices (catalog base prices are in USD). Optional conversion rate from USD.
VITE_CURRENCY=USD
VITE_CURRENCY_RATE=1

# Address the Contact page opens in the visitor's email app.
VITE_CONTACT_EMAIL=
