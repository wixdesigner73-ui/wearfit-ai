# Copy to .env (or set these in your shell / service manager). There are NO secrets here.

# Browser origins allowed to call this API (comma separated, no trailing slash).
# Add your GitHub Pages origin: https://YOUR-USERNAME.github.io
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173,https://YOUR-USERNAME.github.io

# Where model.safetensors and dwpose/ were downloaded (default: backend/weights)
# FASHN_WEIGHTS_DIR=./weights

# Force "cpu" or "cuda". Leave unset for automatic selection.
# TRYON_DEVICE=

# Diffusion steps: 20 fast / 30 balanced (default) / 50 best quality. On CPU try 15-20.
DEFAULT_TIMESTEPS=30

# Seconds before the API answers HTTP 504. CPU inference can take many minutes.
TRYON_TIMEOUT_SECONDS=1800

MAX_UPLOAD_MB=10
MAX_WAITING_REQUESTS=2
